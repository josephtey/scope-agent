# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# OpenAI (for the scoping conversation LLM)
OPENAI_API_KEY=sk-your-openai-key

# GitHub (for issue creation on the client project)
GITHUB_TOKEN=ghp_your-github-token
GITHUB_REPO=josephtey/sample-client-project

# Devin API (for real prototype generation via Devin sessions)
DEVIN_API_KEY=cog_your-devin-api-key

# Client project repo that Devin will customize
CLIENT_PROJECT_REPO=josephtey/sample-client-project

# Pre-created playbook ID (optional — will auto-create if not set)
PROTOTYPE_PLAYBOOK_ID=

# Devin session polling configuration
DEVIN_POLL_INTERVAL=15
DEVIN_SESSION_TIMEOUT=600

# Sample app URL (for local screenshot fallback)
SAMPLE_APP_URL=http://localhost:3000
